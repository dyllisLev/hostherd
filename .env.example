# Copy to .env next to compose.yaml and adjust.

# Required. The public HTTPS address of Hostherd, without a trailing slash.
# Browsers, MCP clients and agents all use it. It must start with https://.
PUBLIC_URL=https://hostherd.example.com

# Bundled HTTPS reverse proxy (Caddy, see Caddyfile). It obtains a certificate
# for the host in PUBLIC_URL and needs ports 80 and 443 on this host. Leave it
# empty (COMPOSE_PROFILES=) if you run your own reverse proxy instead.
COMPOSE_PROFILES=caddy

# Image tag to run: latest, or a version such as 0.1.0 to pin it.
HOSTHERD_VERSION=latest

# Host address and port the container is published on. Keep 127.0.0.1 when
# the reverse proxy runs on the same host. Use 0.0.0.0 only if the proxy runs
# on another machine and the port is firewalled from everyone else.
HOSTHERD_BIND=127.0.0.1
HOSTHERD_PORT=3000

# How many reverse proxies to trust for the client address (used by the login
# rate limit). 1 = one proxy in front (default). Use the number of hops for a
# chain of proxies, a comma-separated list of proxy addresses or subnets, or
# false when nothing sits in front of Hostherd.
TRUST_PROXY=1

# Fixed by the image; no need to set them:
#   PORT=3000      port inside the container
#   HOST=0.0.0.0   listen address inside the container
#   DATA_DIR=/data data directory inside the container (the "data" volume)
